##
# Kopf: Titelzeile wie in einem alten Nachschlagewerk
#
prototype(Astronomique.Site:Component.Header) < prototype(Neos.Fusion:Component) {
    homeUri = Neos.Neos:NodeUri {
        node = ${site}
    }
    menuItems = Neos.Neos:MenuItems {
        maximumLevels = 2
    }

    renderer = afx`
        <header class="as-header" data-as-header>
            <div class="as-container">
                <div class="as-header__top">
                    <span>Astronomique Liquor Company</span>
                    <span class="as-header__star" aria-hidden="true">✶</span>
                    <span>Gin &amp; Fleur de Sel</span>
                </div>
                <div class="as-header__mast">
                    <a class="as-logo" href={props.homeUri} aria-label="Astronomique – Startseite">
                        <img src="https://astronomique.ch/wp-content/uploads/2023/12/Logo_pencil_white.png" alt="Astronomique" height="110" />
                    </a>
                    <button class="as-burger" type="button" aria-label="Menü öffnen" aria-expanded="false" data-as-burger>
                        <span></span><span></span><span></span>
                    </button>
                </div>
                <nav class="as-nav" aria-label="Hauptnavigation" data-as-nav>
                    <ul class="as-nav__list">
                        <Neos.Fusion:Loop items={props.menuItems} itemName="item">
                            <li class={'as-nav__item' + ((item.state && (item.state.value == 'current' || item.state.value == 'active')) ? ' is-active' : '') + ((Type.isArray(item.subItems) && Array.length(item.subItems) > 0) ? ' has-sub' : '')}>
                                <a class="as-nav__link" href={item.uri}>{item.label}</a>
                                <ul class="as-nav__sub" @if.has={Type.isArray(item.subItems) && Array.length(item.subItems) > 0}>
                                    <Neos.Fusion:Loop items={item.subItems} itemName="sub">
                                        <li><a href={sub.uri}>{sub.label}</a></li>
                                    </Neos.Fusion:Loop>
                                </ul>
                            </li>
                        </Neos.Fusion:Loop>
                        <li class="as-nav__item"><a class="as-nav__link as-nav__link--shop" href="https://astronomique.ch/?page_id=7">Shop</a></li>
                    </ul>
                </nav>
            </div>
        </header>
    `

    @cache {
        mode = 'cached'
        entryIdentifier {
            static = 'as-header-lexikon'
            documentNode = ${Neos.Caching.entryIdentifierForNode(documentNode)}
        }
        entryTags {
            1 = ${Neos.Caching.nodeTypeTag('Neos.Neos:Document', documentNode)}
        }
    }
}

##
# Seitenkopf normaler Unterseiten (wie ein Kapitelanfang)
#
prototype(Astronomique.Site:Component.PageHero) < prototype(Neos.Fusion:Component) {
    title = Neos.Neos:Editable {
        node = ${documentNode}
        property = 'title'
        block = false
    }
    teaser = ${q(documentNode).property('teaser')}

    renderer = afx`
        <section class="as-pagehero">
            <div class="as-container as-pagehero__inner">
                <p class="as-kicker">Kapitel</p>
                <h1 class="as-pagehero__title">{props.title}</h1>
                <span class="as-ornament" aria-hidden="true">❧</span>
                <p class="as-pagehero__teaser" @if.has={props.teaser}>{props.teaser}</p>
            </div>
        </section>
    `
}

##
# Kopf einer Produktseite wie ein Lexikoneintrag
#
prototype(Astronomique.Site:Component.ProductHero) < prototype(Neos.Fusion:Component) {
    title = Neos.Neos:Editable {
        node = ${documentNode}
        property = 'title'
        block = false
    }
    subtitle = ${q(documentNode).property('subtitle')}
    teaser = ${q(documentNode).property('teaser')}
    price = ${q(documentNode).property('price')}
    availability = ${q(documentNode).property('availability') || 'instock'}
    shopUrl = ${q(documentNode).property('shopUrl')}
    caption = ${q(documentNode).property('caption') || ('Fig. — ' + q(documentNode).property('title'))}
    facts = ${String.pregSplit(q(documentNode).property('facts') || '', '/\r?\n/')}
    imageSrc = Astronomique.Site:Helper.ImageSrc {
        node = ${documentNode}
        width = 1400
    }
    parentUri = Neos.Neos:NodeUri {
        node = ${q(documentNode).parent().get(0)}
    }

    renderer = afx`
        <section class="as-producthero">
            <div class="as-container as-producthero__inner">
                <Astronomique.Site:Component.Plate src={props.imageSrc} caption={props.caption} alt={q(documentNode).property('title')} variant="tall" />
                <div class="as-producthero__entry">
                    <a class="as-backlink" href={props.parentUri}>← Verzeichnis der Erzeugnisse</a>
                    <h1 class="as-producthero__title">{props.title}</h1>
                    <p class="as-producthero__subtitle" @if.has={props.subtitle}>{props.subtitle}</p>
                    <p class="as-producthero__teaser as-dropcap" @if.has={props.teaser}>{props.teaser}</p>
                    <dl class="as-facts">
                        <Neos.Fusion:Loop items={props.facts} itemName="line">
                            <Neos.Fusion:Fragment @if.has={String.pregMatch(line, '/^\s*([^:]+):\s*(.+)$/')}>
                                <div class="as-facts__row">
                                    <dt>{String.trim(String.pregMatch(line, '/^\s*([^:]+):\s*(.+)$/')[1])}</dt>
                                    <span class="as-entry__dots" aria-hidden="true"></span>
                                    <dd>{String.trim(String.pregMatch(line, '/^\s*([^:]+):\s*(.+)$/')[2])}</dd>
                                </div>
                            </Neos.Fusion:Fragment>
                        </Neos.Fusion:Loop>
                    </dl>
                    <div class="as-producthero__buy">
                        <span class="as-price">{props.price}</span>
                        <a @if.can={props.shopUrl && props.availability == 'instock'} class="as-btn as-btn--ink" href={props.shopUrl}>Bestellen</a>
                        <span @if.cannot={props.availability != 'instock'} class="as-btn as-btn--disabled"><Astronomique.Site:Helper.Availability value={props.availability} /></span>
                    </div>
                </div>
            </div>
        </section>
    `
}

##
# Fuss: Kolophon
#
prototype(Astronomique.Site:Component.Footer) < prototype(Neos.Fusion:Component) {
    pages = ${q(site).children('[instanceof Astronomique.Site:Document.Page]').get()}

    renderer = afx`
        <footer class="as-footer">
            <div class="as-container as-footer__inner">
                <span class="as-ornament" aria-hidden="true">✶ ✶ ✶</span>
                <img class="as-footer__logo" src="https://astronomique.ch/wp-content/uploads/2023/12/Logo_pencil_white.png" alt="Astronomique" height="80" loading="lazy" />
                <p class="as-footer__name">Astronomique Liquor Company</p>
                <nav class="as-footer__nav" aria-label="Fussnavigation">
                    <Neos.Fusion:Loop items={props.pages} itemName="p">
                        <Neos.Neos:NodeLink node={p} />
                    </Neos.Fusion:Loop>
                    <a href="https://astronomique.ch/?page_id=7">Shop</a>
                    <a href="https://www.facebook.com/balinightsgin/" target="_blank" rel="noopener">Facebook</a>
                    <a href="https://www.instagram.com/" target="_blank" rel="noopener">Instagram</a>
                </nav>
                <p class="as-footer__age">Genuss mit Verantwortung. Abgabe von Spirituosen nur an Personen ab 18 Jahren.</p>
                <p class="as-footer__colophon">© 2026 Astronomique Liquor Company</p>
            </div>
        </footer>
    `

    @cache {
        mode = 'cached'
        entryIdentifier {
            static = 'as-footer-lexikon'
            site = ${Neos.Caching.entryIdentifierForNode(site)}
        }
        entryTags {
            1 = ${Neos.Caching.nodeTypeTag('Neos.Neos:Document', site)}
        }
    }
}
