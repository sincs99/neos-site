prototype(Astronomique.Site:Document.Page) < prototype(Neos.Fusion:Component) {
    isHome = false

    renderer = Neos.Neos:Page {
        htmlTag.attributes.lang = 'de'
        head {
            metaViewport = '<meta name="viewport" content="width=device-width, initial-scale=1">'
            themeColor = '<meta name="theme-color" content="#070914">'
            robots = '<meta name="robots" content="noindex, nofollow">'
            description = Neos.Fusion:Tag {
                tagName = 'meta'
                attributes.name = 'description'
                attributes.content = ${q(documentNode).property('teaser') || 'Astronomique Liquor Company – Bali Nights Tropical Gin und Fleur de Sel aus Mauritius.'}
            }
            fonts = '<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=Manrope:wght@400;500;600;700&display=swap">'
            stylesheets.site = afx`<link rel="stylesheet" href={StaticResource.uri('Astronomique.Site', 'Public/Styles/main.css')} />`
            javascripts.site = afx`<script src={StaticResource.uri('Astronomique.Site', 'Public/Scripts/main.js')} defer></script>`
        }

        bodyTag.attributes.class = ${props.isHome ? 'as as--home' : 'as as--sub'}

        body = afx`
            <a class="as-skip" href="#main">Zum Inhalt springen</a>
            <Astronomique.Site:Component.Header />
            <main id="main" class="as-main">
                <Astronomique.Site:Component.ProductHero @if.product={q(documentNode).is('[instanceof Astronomique.Site:Document.Product]')} />
                <Astronomique.Site:Component.PageHero @if.page={!props.isHome && !q(documentNode).is('[instanceof Astronomique.Site:Document.Product]')} />
                <Neos.Neos:ContentCollection nodePath="main" attributes.class={['as-content']} />
            </main>
            <Astronomique.Site:Component.Footer />
        `
    }
}

prototype(Astronomique.Site:Document.HomePage) < prototype(Astronomique.Site:Document.Page) {
    isHome = true
}

prototype(Astronomique.Site:Document.Product) < prototype(Astronomique.Site:Document.Page)
