##
# Gemeinsame Felder
#
prototype(Astronomique.Site:Content.Base) < prototype(Neos.Neos:ContentComponent) {
    kicker = Neos.Neos:Editable {
        property = 'kicker'
        block = false
    }
    headline = Neos.Neos:Editable {
        property = 'headline'
        block = false
    }
    text = Neos.Neos:Editable {
        property = 'text'
    }
    anchor = ${q(node).property('anchor') || null}
    primaryLabel = ${q(node).property('primaryLabel')}
    primaryLink = ${q(node).property('primaryLink')}
    secondaryLabel = ${q(node).property('secondaryLabel')}
    secondaryLink = ${q(node).property('secondaryLink')}
    imageSrc = Astronomique.Site:Helper.ImageSrc {
        width = 1600
    }

    @process.convertUris = Neos.Neos:ConvertUris
}

##
# Bühne mit Sternenhimmel
#
prototype(Astronomique.Site:Content.Hero) < prototype(Astronomique.Site:Content.Base) {
    renderer = afx`
        <section class="as-hero" id={props.anchor}>
            <canvas class="as-stars" data-as-stars aria-hidden="true"></canvas>
            <span class="as-hero__moon" aria-hidden="true"></span>
            <div class="as-container as-hero__inner">
                <div class="as-hero__copy">
                    <p class="as-kicker">{props.kicker}</p>
                    <h1 class="as-hero__title">{props.headline}</h1>
                    <div class="as-hero__text">{props.text}</div>
                    <div class="as-hero__actions">
                        <a class="as-btn as-btn--gold" href={props.primaryLink} @if.has={props.primaryLabel}>{props.primaryLabel}</a>
                        <a class="as-btn as-btn--ghost" href={props.secondaryLink} @if.has={props.secondaryLabel}>{props.secondaryLabel}</a>
                    </div>
                </div>
                <div class="as-hero__stage">
                    <span class="as-product__halo" aria-hidden="true"></span>
                    <img @if.has={props.imageSrc} src={props.imageSrc} alt="" />
                </div>
            </div>
            <a class="as-hero__scroll" href="#entdecken" aria-label="Weiter nach unten"><span></span></a>
        </section>
    `
}

##
# Zitat
#
prototype(Astronomique.Site:Content.Quote) < prototype(Neos.Neos:ContentComponent) {
    quote = Neos.Neos:Editable {
        property = 'quote'
        block = false
    }
    source = Neos.Neos:Editable {
        property = 'source'
        block = false
    }

    renderer = afx`
        <section class="as-quote" id="entdecken">
            <div class="as-container as-quote__inner">
                <span class="as-quote__star" aria-hidden="true">✦</span>
                <blockquote class="as-quote__text">{props.quote}</blockquote>
                <p class="as-quote__source">{props.source}</p>
            </div>
        </section>
    `
}

##
# Produkte (automatisch aus den Produktseiten)
#
prototype(Astronomique.Site:Content.ProductList) < prototype(Astronomique.Site:Content.Base) {
    products = ${q(site).find('[instanceof Astronomique.Site:Document.Product]').get()}

    renderer = afx`
        <section class="as-section as-products" id={props.anchor}>
            <div class="as-container">
                <Astronomique.Site:Component.SectionHead kicker={props.kicker} headline={props.headline} text={props.text} />
                <div class="as-productgrid">
                    <Neos.Fusion:Loop items={props.products} itemName="product">
                        <Astronomique.Site:Component.ProductCard product={product} />
                    </Neos.Fusion:Loop>
                </div>
            </div>
        </section>
    `

    @cache {
        mode = 'cached'
        entryIdentifier {
            node = ${Neos.Caching.entryIdentifierForNode(node)}
        }
        entryTags {
            1 = ${Neos.Caching.nodeTag(node)}
            2 = ${Neos.Caching.nodeTypeTag('Astronomique.Site:Document.Product', node)}
        }
    }
}

##
# Text mit Bild
#
prototype(Astronomique.Site:Content.TextImage) < prototype(Astronomique.Site:Content.Base) {
    imageRight = ${q(node).property('imageRight')}

    renderer = afx`
        <section class={'as-section as-textimage' + (props.imageRight ? ' as-textimage--right' : '')} id={props.anchor}>
            <div class="as-container as-textimage__inner">
                <figure class="as-textimage__media">
                    <img @if.has={props.imageSrc} src={props.imageSrc} alt="" loading="lazy" />
                </figure>
                <div class="as-textimage__copy">
                    <p class="as-kicker">{props.kicker}</p>
                    <h2 class="as-h2">{props.headline}</h2>
                    <div class="as-prose">{props.text}</div>
                    <div class="as-actions" @if.has={props.primaryLabel || props.secondaryLabel}>
                        <a class="as-btn as-btn--gold" href={props.primaryLink} @if.has={props.primaryLabel}>{props.primaryLabel}</a>
                        <a class="as-btn as-btn--ghost" href={props.secondaryLink} @if.has={props.secondaryLabel}>{props.secondaryLabel}</a>
                    </div>
                </div>
            </div>
        </section>
    `
}

##
# Merkmale
#
prototype(Astronomique.Site:Content.Features) < prototype(Astronomique.Site:Content.Base) {
    renderer = afx`
        <section class="as-section as-features" id={props.anchor}>
            <div class="as-container">
                <Astronomique.Site:Component.SectionHead kicker={props.kicker} headline={props.headline} text={props.text} />
                <Neos.Neos:ContentCollection nodePath="items" attributes.class={['as-featuregrid']} />
            </div>
        </section>
    `
}

prototype(Astronomique.Site:Content.Feature) < prototype(Neos.Neos:ContentComponent) {
    title = Neos.Neos:Editable {
        property = 'title'
        block = false
    }
    text = Neos.Neos:Editable {
        property = 'text'
    }
    icon = ${q(node).property('icon') || 'star'}

    renderer = afx`
        <div class="as-feature">
            <span class="as-feature__icon"><Astronomique.Site:Helper.Icon name={props.icon} /></span>
            <h3 class="as-feature__title">{props.title}</h3>
            <div class="as-feature__text">{props.text}</div>
        </div>
    `
}

##
# Text
#
prototype(Astronomique.Site:Content.Text) < prototype(Astronomique.Site:Content.Base) {
    renderer = afx`
        <section class="as-section as-text" id={props.anchor}>
            <div class="as-container as-container--narrow">
                <p class="as-kicker">{props.kicker}</p>
                <h2 class="as-h2">{props.headline}</h2>
                <div class="as-prose">{props.text}</div>
            </div>
        </section>
    `
}

##
# Aufruf
#
prototype(Astronomique.Site:Content.Cta) < prototype(Astronomique.Site:Content.Base) {
    renderer = afx`
        <section class="as-cta" id={props.anchor}>
            <canvas class="as-stars" data-as-stars aria-hidden="true"></canvas>
            <div class="as-container as-cta__inner">
                <p class="as-kicker">{props.kicker}</p>
                <h2 class="as-h2">{props.headline}</h2>
                <div class="as-cta__text">{props.text}</div>
                <div class="as-actions as-actions--center">
                    <a class="as-btn as-btn--gold" href={props.primaryLink} @if.has={props.primaryLabel}>{props.primaryLabel}</a>
                    <a class="as-btn as-btn--ghost" href={props.secondaryLink} @if.has={props.secondaryLabel}>{props.secondaryLabel}</a>
                </div>
            </div>
        </section>
    `
}
