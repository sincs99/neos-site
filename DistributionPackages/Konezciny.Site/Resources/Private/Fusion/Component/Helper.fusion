##
# Linien-Symbole 24x24
#
prototype(Konezciny.Site:Helper.Icon) < prototype(Neos.Fusion:Component) {
    name = 'check'

    renderer = Neos.Fusion:Join {
        open = '<svg class="kz-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">'
        paths = Neos.Fusion:Match {
            @subject = ${props.name}
            @default = '<path d="M20 6 9 17l-5-5"/>'
            server = '<rect x="3" y="3" width="18" height="7" rx="2"/><rect x="3" y="14" width="18" height="7" rx="2"/><path d="M7 6.5h.01M7 17.5h.01M11 6.5h6M11 17.5h6"/>'
            code = '<path d="m16 18 6-6-6-6"/><path d="m8 6-6 6 6 6"/>'
            terminal = '<path d="m4 17 6-5-6-5"/><path d="M12 19h8"/>'
            shield = '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>'
            chart = '<path d="M3 3v18h18"/><path d="m7 15 4-4 3 3 5-6"/>'
            bot = '<rect x="4" y="8" width="16" height="12" rx="3"/><path d="M12 4v4"/><circle cx="12" cy="3" r="1"/><path d="M9 13h.01M15 13h.01"/><path d="M9.5 17h5"/>'
            film = '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M7 3v18M17 3v18M3 8h4M3 12h18M3 16h4M17 8h4M17 16h4"/>'
            home = '<path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/>'
            gamepad = '<path d="M6 12h4M8 10v4"/><path d="M15 11h.01M18 13h.01"/><path d="M17.3 5H6.7a4 4 0 0 0-4 3.6l-.7 6.2A3 3 0 0 0 5 18c1 0 2-.5 2.6-1.4L9 15h6l1.4 1.6c.6.9 1.6 1.4 2.6 1.4a3 3 0 0 0 3-3.2l-.7-6.2a4 4 0 0 0-4-3.6z"/>'
            calendar = '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/><path d="M8 14h.01M12 14h.01M16 14h.01M8 18h.01M12 18h.01"/>'
            globe = '<circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15 15 0 0 1 4 10 15 15 0 0 1-4 10 15 15 0 0 1-4-10 15 15 0 0 1 4-10z"/>'
            cloud = '<path d="M17.5 19H9a7 7 0 1 1 6.7-9h1.8a4.5 4.5 0 1 1 0 9z"/>'
            bell = '<path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.9 1.9 0 0 0 3.4 0"/>'
            lock = '<rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>'
            database = '<ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14a9 3 0 0 0 18 0V5"/><path d="M3 12a9 3 0 0 0 18 0"/>'
            tv = '<rect x="2" y="7" width="20" height="15" rx="2"/><path d="m17 2-5 5-5-5"/>'
            arrow = '<path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>'
            arrowLeft = '<path d="M19 12H5"/><path d="m12 19-7-7 7-7"/>'
            external = '<path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>'
            github = '<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.1-1.3-.3-2.5-1-3.5.3-1.2.3-2.4 0-3.5 0 0-1 0-3 1.5a10.4 10.4 0 0 0-5.5 0C8.5 2 7.5 2 7.5 2c-.3 1.1-.3 2.3 0 3.5A5.4 5.4 0 0 0 6.5 9c0 3.5 3 5.5 6 5.5-.4.5-.7 1-.8 1.6-.2.6-.2 1.3-.2 1.9v4"/><path d="M9 18c-4.5 2-5-2-7-2"/>'
            mail = '<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/>'
        }
        close = '</svg>'
    }
}

##
# Statusbezeichnung eines Projekts
#
prototype(Konezciny.Site:Helper.StatusLabel) < prototype(Neos.Fusion:Component) {
    status = 'live'
    renderer = Neos.Fusion:Match {
        @subject = ${props.status}
        @default = 'Live'
        pilot = 'Pilot'
        dev = 'In Entwicklung'
        paused = 'Pausiert'
    }
}

##
# Abschnittskopf
#
prototype(Konezciny.Site:Component.SectionHead) < prototype(Neos.Fusion:Component) {
    kicker = null
    headline = null
    text = null

    renderer = afx`
        <header class="kz-sectionhead">
            <p class="kz-kicker" @if.has={props.kicker}>{props.kicker}</p>
            <h2 class="kz-h2">{props.headline}</h2>
            <div class="kz-sectionhead__text" @if.has={props.text}>{props.text}</div>
        </header>
    `
}

##
# Projektkarte (aus einer Projektseite)
#
prototype(Konezciny.Site:Component.ProjectCard) < prototype(Neos.Fusion:Component) {
    project = null

    renderer = Neos.Fusion:Component {
        @apply.props = ${props}
        uri = Neos.Neos:NodeUri {
            node = ${props.project}
        }
        title = ${q(props.project).property('title')}
        teaser = ${q(props.project).property('teaser')}
        status = ${q(props.project).property('status') || 'live'}
        icon = ${q(props.project).property('icon') || 'code'}
        accent = ${q(props.project).property('accent') || 'violet'}
        tags = ${String.split(q(props.project).property('tags') || '', ',')}

        renderer = afx`
            <a class={'kz-project kz-accent--' + props.accent} href={props.uri}>
                <span class="kz-project__glow" aria-hidden="true"></span>
                <span class="kz-project__top">
                    <span class="kz-project__icon"><Konezciny.Site:Helper.Icon name={props.icon} /></span>
                    <span class={'kz-status kz-status--' + props.status}><Konezciny.Site:Helper.StatusLabel status={props.status} /></span>
                </span>
                <h3 class="kz-project__title">{props.title}</h3>
                <p class="kz-project__teaser">{props.teaser}</p>
                <span class="kz-tags">
                    <Neos.Fusion:Loop items={props.tags} itemName="tag">
                        <span class="kz-tag" @if.has={String.trim(tag)}>{String.trim(tag)}</span>
                    </Neos.Fusion:Loop>
                </span>
                <span class="kz-project__more">Details <Konezciny.Site:Helper.Icon name="arrow" /></span>
            </a>
        `
    }
}

##
# Eine Zeile im Status-Terminal der Bühne
#
prototype(Konezciny.Site:Component.TerminalRow) < prototype(Neos.Fusion:Component) {
    project = null

    renderer = Neos.Fusion:Component {
        @apply.props = ${props}
        uri = Neos.Neos:NodeUri {
            node = ${props.project}
        }
        title = ${q(props.project).property('title')}
        status = ${q(props.project).property('status') || 'live'}

        renderer = afx`
            <a class="kz-terminal__row" href={props.uri}>
                <span class={'kz-dot kz-dot--' + props.status}></span>
                <span class="kz-terminal__name">{props.title}</span>
                <span class={'kz-terminal__state kz-terminal__state--' + props.status}><Konezciny.Site:Helper.StatusLabel status={props.status} /></span>
            </a>
        `
    }
}
