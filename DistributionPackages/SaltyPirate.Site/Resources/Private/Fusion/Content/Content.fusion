##
# Aufruf
#
prototype(SaltyPirate.Site:Content.Cta) < prototype(SaltyPirate.Site:Content.Base) {
    renderer = afx`
        <section class="sp-section sp-cta" id={props.anchor}>
            <div class="sp-container">
                <div class="sp-cta__box">
                    <SaltyPirate.Site:Component.Compass />
                    <p class="sp-kicker">{props.kicker}</p>
                    <h2 class="sp-h2">{props.headline}</h2>
                    <div class="sp-cta__text">{props.text}</div>
