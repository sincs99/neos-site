##
# Links aus der Startseite: Einladung + Community-Server (leer = "coming soon")
#
prototype(SaltyPirate.Site:Helper.InviteUrl) < prototype(Neos.Fusion:Value) {
    value = ${q(site).property('inviteUrl') || ''}
}
prototype(SaltyPirate.Site:Helper.SupportUrl) < prototype(Neos.Fusion:Value) {
    value = ${q(site).property('supportUrl') || ''}
}

##
# Buttons "Add to Discord" und "Join the crew" (zeigen "coming soon", solange kein Link gesetzt ist)
#
prototype(SaltyPirate.Site:Component.BotButtons) < prototype(Neos.Fusion:Component) {
    invite = SaltyPirate.Site:Helper.InviteUrl
    support = SaltyPirate.Site:Helper.SupportUrl
    showSupport = true

    renderer = afx`
        <div class="sp-actions">
            <a @if.has={props.invite} class="sp-btn sp-btn--discord" href={props.invite} target="_blank" rel="noopener">
                <SaltyPirate.Site:Helper.DiscordLogo /> Add to Discord
            </a>
            <span @if.none={!props.invite} class="sp-btn sp-btn--discord sp-btn--soon" title="Invite link coming soon">
                <SaltyPirate.Site:Helper.DiscordLogo /> Add to Discord <small>soon</small>
            </span>
            <Neos.Fusion:Fragment @if.support={props.showSupport}>
                <a @if.has={props.support} class="sp-btn sp-btn--ghost" href={props.support} target="_blank" rel="noopener">Join the crew</a>
                <span @if.none={!props.support} class="sp-btn sp-btn--ghost sp-btn--soon" title="Community server coming soon">Community server <small>soon</small></span>
            </Neos.Fusion:Fragment>
        </div>
    `
}

prototype(SaltyPirate.Site:Helper.DiscordLogo) < prototype(Neos.Fusion:Value) {
    value = '<svg class="sp-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.3 4.4A19.6 19.6 0 0 0 15.4 3l-.6 1.3a18 18 0 0 0-5.6 0L8.6 3a19.5 19.5 0 0 0-4.9 1.4C.6 9 -.3 13.5.1 18a19.8 19.8 0 0 0 6 3l1.3-2.1a12.7 12.7 0 0 1-2-1l.5-.4a14 14 0 0 0 12.2 0l.5.4c-.6.4-1.3.7-2 1l1.3 2.1a19.7 19.7 0 0 0 6-3c.5-5.2-.9-9.7-3.6-13.6zM8.5 15.3c-1.2 0-2.2-1.1-2.2-2.4s1-2.4 2.2-2.4c1.2 0 2.2 1.1 2.2 2.4s-1 2.4-2.2 2.4zm7 0c-1.2 0-2.2-1.1-2.2-2.4s1-2.4 2.2-2.4c1.2 0 2.2 1.1 2.2 2.4s-1 2.4-2.2 2.4z"/></svg>'
}

##
# Abschnittskopf
#
prototype(SaltyPirate.Site:Component.SectionHead) < prototype(Neos.Fusion:Component) {
    kicker = null
    headline = null
    text = null
    center = true

    renderer = afx`
        <header class={'sp-sectionhead' + (props.center ? ' sp-sectionhead--center' : '')}>
            <p class="sp-kicker" @if.has={props.kicker}>{props.kicker}</p>
            <h2 class="sp-h2">{props.headline}</h2>
            <div class="sp-sectionhead__text" @if.has={props.text}>{props.text}</div>
        </header>
    `
}

##
# Nachgebaute Discord-Nachricht des Bots
#
prototype(SaltyPirate.Site:Component.DiscordMock) < prototype(Neos.Fusion:Component) {
    command = ${q(node).property('mockCommand')}
    title = ${q(node).property('mockTitle')}
    lines = ${String.pregSplit(q(node).property('mockBody') || '', '/\r?\n/')}
    buttons = ${String.split(q(node).property('mockButtons') || '', ',')}
    color = ${q(node).property('mockColor') || 'blurple'}

    renderer = afx`
        <div class="sp-discord" aria-label="Example of a Salty Pirate reply in Discord">
            <div class="sp-discord__bar">
                <span class="sp-discord__hash">#</span> tavern
            </div>
            <div class="sp-discord__msg sp-discord__msg--user" @if.cmd={props.command}>
                <span class="sp-discord__avatar sp-discord__avatar--user">⚓</span>
                <div class="sp-discord__content">
                    <span class="sp-discord__name">Deckhand</span>
                    <code class="sp-discord__cmd">{props.command}</code>
                </div>
            </div>
            <div class="sp-discord__msg">
                <span class="sp-discord__avatar">☠</span>
                <div class="sp-discord__content">
                    <span class="sp-discord__name">Salty Pirate <span class="sp-discord__bot">APP</span></span>
                    <div class={'sp-embed sp-embed--' + props.color}>
                        <p class="sp-embed__title">{props.title}</p>
                        <Neos.Fusion:Loop items={props.lines} itemName="line">
                            <p class="sp-embed__line" @if.has={String.trim(line)}>
                                <Neos.Fusion:Fragment @if.field={String.pregMatch(line, '/^([^:]{1,30}):\s*(.+)$/')}>
                                    <strong>{String.pregMatch(line, '/^([^:]{1,30}):\s*(.+)$/')[1]}</strong>
                                    <span>{String.pregMatch(line, '/^([^:]{1,30}):\s*(.+)$/')[2]}</span>
                                </Neos.Fusion:Fragment>
                                <Neos.Fusion:Fragment @if.plain={!String.pregMatch(line, '/^([^:]{1,30}):\s*(.+)$/')}>{line}</Neos.Fusion:Fragment>
                            </p>
                        </Neos.Fusion:Loop>
                    </div>
                    <div class="sp-discord__buttons" @if.has={Array.length(props.buttons) > 0 && String.trim(props.buttons[0])}>
                        <Neos.Fusion:Loop items={props.buttons} itemName="b" iterationName="i">
                            <span class={'sp-dbtn' + (i.isFirst ? ' sp-dbtn--primary' : '')}>{String.trim(b)}</span>
                        </Neos.Fusion:Loop>
                    </div>
                </div>
            </div>
        </div>
    `
}

##
# Einfache Linien-Symbole
#
prototype(SaltyPirate.Site:Helper.Icon) < prototype(Neos.Fusion:Component) {
    name = 'check'
    renderer = Neos.Fusion:Join {
        open = '<svg class="sp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">'
        paths = Neos.Fusion:Match {
            @subject = ${props.name}
            @default = '<path d="M20 6 9 17l-5-5"/>'
            shield = '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>'
            arrow = '<path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>'
        }
        close = '</svg>'
    }
}
