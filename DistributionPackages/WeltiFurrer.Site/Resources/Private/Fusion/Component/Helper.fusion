##
# Bildquelle: Neos-Bild (Medienverwaltung) hat Vorrang, sonst die Entwurfs-URL
#
prototype(WeltiFurrer.Site:Helper.ImageSrc) < prototype(Neos.Fusion:Component) {
    node = ${node}
    property = 'image'
    urlProperty = 'imageUrl'
    width = 1600

    renderer = Neos.Fusion:Case {
        asset {
            condition = ${q(props.node).property(props.property)}
            renderer = Neos.Neos:ImageUri {
                asset = ${q(props.node).property(props.property)}
                maximumWidth = ${props.width}
            }
        }
        url {
            condition = true
            renderer = ${q(props.node).property(props.urlProperty)}
        }
    }
}

##
# Abschnittskopf (Dachzeile, Titel, Einleitung)
#
prototype(WeltiFurrer.Site:Component.SectionHead) < prototype(Neos.Fusion:Component) {
    kicker = null
    headline = null
    text = null
    center = false
    light = false

    renderer = afx`
        <header class={'wf-sectionhead' + (props.center ? ' wf-sectionhead--center' : '') + (props.light ? ' wf-sectionhead--light' : '')}>
            <p class="wf-kicker" @if.has={props.kicker}>{props.kicker}</p>
            <h2 class="wf-h2">{props.headline}</h2>
            <div class="wf-sectionhead__text" @if.has={props.text}>{props.text}</div>
        </header>
    `
}

##
# Symbole (Linien-Icons, 24x24)
#
prototype(WeltiFurrer.Site:Helper.Icon) < prototype(Neos.Fusion:Component) {
    name = 'check'

    renderer = Neos.Fusion:Join {
        open = '<svg class="wf-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">'
        paths = Neos.Fusion:Match {
        @subject = ${props.name}
        @default = '<path d="M20 6 9 17l-5-5"/>'
        truck = '<path d="M1 4h14v12H1z"/><path d="M15 8h4l3 3.5V16h-7z"/><circle cx="5.5" cy="18" r="2"/><circle cx="17.5" cy="18" r="2"/>'
        building = '<path d="M3 21h18"/><path d="M5 21V6l8-3v18"/><path d="M19 21V10l-6-3"/><path d="M8.5 8.5h1M8.5 12h1M8.5 15.5h1"/>'
        box = '<path d="M21 8 12 3 3 8v8l9 5 9-5z"/><path d="m3 8 9 5 9-5"/><path d="M12 13v8"/>'
        art = '<rect x="3" y="3" width="18" height="18" rx="1"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/>'
        crane = '<path d="M5 21V3h2"/><path d="M5 6h15"/><path d="M8 3 5 6"/><path d="M17 6v5"/><path d="M15 11h4v3h-4z"/><path d="M2 21h7"/>'
        leaf = '<path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.5 19 2c1 2 2 4.2 2 8 0 5.5-4.8 10-10 10Z"/><path d="M2 21c0-3 1.9-5.4 5.1-6C9.5 14.5 12 13 13 12"/>'
        shield = '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>'
        globe = '<circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15 15 0 0 1 4 10 15 15 0 0 1-4 10 15 15 0 0 1-4-10 15 15 0 0 1 4-10z"/>'
        clock = '<circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>'
        people = '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.9"/><path d="M16 3.1a4 4 0 0 1 0 7.8"/>'
        phone = '<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/>'
        pin = '<path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/>'
        arrow = '<path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>'
        }
        close = '</svg>'
    }
}
